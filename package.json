{
  "name": "dsh-remielle-dan",
  "version": "0.2.1",
  "description": "Remielle Dan — 自建 DSH Web 主题插件（不依赖皮肤中心）",
  "type": "module",
  "license": "BSD-3-Clause",
  "main": "./host.js",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "host.js",
    "client.js",
    "styles",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE",
    "README.md",
    "zzz-remielle-dan/assets"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "theme",
    "plugin"
  ]
}
